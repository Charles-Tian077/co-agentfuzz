include README.md LICENSE.txt THIRD_PARTY.md requirements.txt requirements-dev.txt
recursive-include src/co_agent_fuzz/config *.yaml
include src/Experiment/project_identity.json
include src/PromptFuzz/Fuzzer/LICENSE
