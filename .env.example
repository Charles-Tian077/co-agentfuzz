# Optional legacy OpenAI-compatible client configuration.
# Never put a real secret here or commit a local .env file.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
# OPENAI_API_KEY=
# Optional legacy paths; set explicitly in your shell (this file is not auto-loaded).
# COAGENT_DATA_ROOT=/absolute/path/to/authorized/private-datasets
# COAGENT_OUTPUT_ROOT=/absolute/path/to/private-outputs
# COAGENT_PROJECT_ROOT=/absolute/path/to/co-agentfuzz

# Existing offline model cache; the Slurm template does not download weights.
# OLLAMA_MODELS=/absolute/path/to/your/authorized/model-cache
# MODEL=qwen2.5:7b
# PHASE=smoke
# SEED=101
# V32_GPU_COUNT=4
# V32_GPU_LAYERS=20
