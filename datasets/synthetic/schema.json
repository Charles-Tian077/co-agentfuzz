{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Charles-Tian077/co-agentfuzz/main/datasets/synthetic/schema.json",
  "title": "Co-AgentFuzz fixed fictional-record row",
  "description": "One immutable exported task. Expected fields are reserved for the external verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "kind",
    "source",
    "expected",
    "phase",
    "intervention"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^(train|eval)-(contact|inventory|meeting)-[0-9]{2}$"
    },
    "kind": {
      "enum": [
        "contact",
        "inventory",
        "meeting"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "phase": {
      "enum": [
        "train",
        "eval"
      ]
    },
    "intervention": {
      "enum": [
        "clean",
        "missing",
        "extra",
        "wrong_value",
        "wrong_type",
        "syntax"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "contact"
          }
        }
      },
      "then": {
        "properties": {
          "case_id": {
            "pattern": "^(train|eval)-contact-[0-9]{2}$"
          },
          "expected": {
            "required": [
              "name",
              "city"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "city": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "inventory"
          }
        }
      },
      "then": {
        "properties": {
          "case_id": {
            "pattern": "^(train|eval)-inventory-[0-9]{2}$"
          },
          "expected": {
            "required": [
              "item",
              "color"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "color": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "meeting"
          }
        }
      },
      "then": {
        "properties": {
          "case_id": {
            "pattern": "^(train|eval)-meeting-[0-9]{2}$"
          },
          "expected": {
            "required": [
              "day",
              "location"
            ],
            "properties": {
              "day": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "train"
          }
        }
      },
      "then": {
        "properties": {
          "case_id": {
            "pattern": "^train-"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "eval"
          }
        }
      },
      "then": {
        "properties": {
          "case_id": {
            "pattern": "^eval-"
          }
        }
      }
    }
  ]
}
